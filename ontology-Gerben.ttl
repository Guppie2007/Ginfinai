@prefix : <http://example.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .

# Define Classes
:Photo a rdfs:Class ;
    rdfs:label "Photo" ;
    rdfs:subClassOf foaf:Image .

:Person a rdfs:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf foaf:Person .

:Location a rdfs:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf geo:SpatialThing .

# Define Properties
:hasTitle a rdf:Property ;
    rdfs:label "has title" ;
    rdfs:domain :Photo ;
    rdfs:range xsd:string .

:takenBy a rdf:Property ;
    rdfs:label "taken by" ;
    rdfs:domain :Photo ;
    rdfs:range :Person ;
    rdfs:subPropertyOf foaf:maker .

:depictsPerson a rdf:Property ;
    rdfs:label "depicts person" ;
    rdfs:domain :Photo ;
    rdfs:range :Person ;
    rdfs:subPropertyOf foaf:depicts .

:takenAt a rdf:Property ;
    rdfs:label "taken at" ;
    rdfs:domain :Photo ;
    rdfs:range :Location .

:hasDescription a rdf:Property ;
    rdfs:label "has description" ;
    rdfs:domain :Photo ;
    rdfs:range xsd:string .

:hasImage a rdf:Property ;
    rdfs:label "has image" ;
    rdfs:domain :Photo ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf foaf:depiction .

:hasFullName a rdf:Property ;
    rdfs:label "has full name" ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    owl:equivalentProperty foaf:name .

:hasProfile a rdf:Property ;
    rdfs:label "has profile" ;
    rdfs:domain :Person ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf foaf:homepage .

:hasLocationName a rdf:Property ;
    rdfs:label "has location name" ;
    rdfs:domain :Location ;
    rdfs:range xsd:string .